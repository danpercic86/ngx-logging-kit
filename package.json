{
  "name": "ngx-logging-kit",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test-build-publish": "npm run test && npm run build && cd dist/ngx-logging-kit && npm publish",
    "test": "ng test --project=ngx-logging-kit --watch=false",
    "test-watch": "ng test --project=ngx-logging-kit --watch=true",
    "test:schematics": "tsc -p projects/ngx-logging-kit/schematics/tsconfig.json && vitest run projects/ngx-logging-kit/schematics/migration/index.spec.ts",
    "lint": "ng lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,scss,css}": [
      "prettier --write"
    ]
  },
  "private": true,
  "packageManager": "yarn@1.22.17",
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vlq": "^2.0.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.13",
    "@angular-eslint/builder": "20.0.0",
    "@angular/cli": "^20.3.13",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "angular-eslint": "20.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "ng-packagr": "^20.0.0",
    "prettier": "^3.7.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15"
  }
}
