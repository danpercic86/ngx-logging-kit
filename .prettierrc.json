{
  "semi": true,
  "useTabs": false,
  "printWidth": 110,
  "tabWidth": 4,
  "singleQuote": false,
  "trailingComma": "all",
  "experimentalTernaries": true,
  "htmlWhitespaceSensitivity": "ignore",
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "overrides": [
    {
      "files": "**/*.html",
      "options": {
        "parser": "angular",
        "editorconfig": true
      }
    },
    {
      "files": "**/*.{json,yml,yaml}",
      "options": {
        "tabWidth": 2,
        "editorconfig": true
      }
    }
  ]
}
